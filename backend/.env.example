DATABASE_URL="file:../dev.db"
# Set this locally to Render's external PostgreSQL URL only while migrating.
# Keep the URL secret and never commit it.
# POSTGRES_MIGRATION_URL=""
PORT=3000
# Optional absolute path for persistent uploaded files (Render disk: /var/data/uploads).
# Defaults to ./uploads when unset.
UPLOADS_DIR=
ADMIN_API_KEY="12346789123456789123456"
VISITOR_TOKEN_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
# Optional OSRM-compatible route service base URL. The built-in public demo default is best-effort only.
ROUTING_SERVICE_URL="https://router.project-osrm.org/route/v1/driving"

# Optional Nominatim-compatible geographic search endpoint.
GEOCODER_URL="https://nominatim.openstreetmap.org/search"
