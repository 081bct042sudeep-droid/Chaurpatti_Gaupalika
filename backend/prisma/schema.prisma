generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/map-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ImportBatch {
  id                 String   @id @default(cuid())
  sourceType         String
  sourceName         String
  sourceUrl          String
  fetchedAt          DateTime @default(now())
  importedAt         DateTime?
  importingAdminId   String?
  recordsFetched     Int      @default(0)
  newRecords         Int      @default(0)
  updatedRecords     Int      @default(0)
  conflicts          Int      @default(0)
  failedRecords      Int      @default(0)
  status             String   @default("PENDING_REVIEW")
  createdAt          DateTime @default(now())
}

model SourceMetadata {
  id                 String   @id @default(cuid())
  sourceType         String
  sourceName         String
  sourceUrl          String
  sourceRecordId     String?
  sourcePublishedAt  DateTime?
  lastFetchedAt      DateTime?
  lastVerifiedAt     DateTime?
  verificationStatus String   @default("UNVERIFIED")
  importBatchId      String?
  manuallyEdited     Boolean  @default(false)
  manualEditAt       DateTime?
  manuallyEditedBy   String?
  ward               Ward? @relation("WardSource")
  representative     Representative? @relation("RepresentativeSource")
  notice             Notice? @relation("NoticeSource")
}

model Ward {
  id                 String   @id @default(cuid())
  number             Int      @unique
  nameNp             String?
  nameEn             String?
  office             String?
  contact            String?
  status             String   @default("DRAFT")
  sourceMetadataId   String? @unique
  source             SourceMetadata? @relation("WardSource", fields: [sourceMetadataId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MapCategory {
  id        String      @id @default(cuid())
  slug      String      @unique
  nameNp    String
  nameEn    String
  icon      String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  places    MapPlace[]
}

model MapPlace {
  id             String      @id @default(cuid())
  slug           String      @unique
  nameNp         String
  nameEn         String?
  descriptionNp  String?
  descriptionEn  String?
  categoryId     String
  wardNumber     Int?
  latitude       Float?
  longitude      Float?
  geometryType   String      @default("POINT")
  geometry       String?
  address        String?
  phone          String?
  email          String?
  website        String?
  imageUrl       String?
  openingHours   String?
  isPublished    Boolean     @default(false)
  isVerified     Boolean     @default(false)
  sourceName     String?
  sourceUrl      String?
  verifiedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  category       MapCategory @relation(fields: [categoryId], references: [id])
  @@index([isPublished, isVerified, wardNumber])
  @@index([categoryId])
}

model MapBoundary {
  id          String   @id @default(cuid())
  name        String
  layerType   String   @default("WARD_BOUNDARY")
  wardNumber  Int?
  geoJson     String
  sourceName  String?
  sourceUrl   String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([isPublished, layerType, wardNumber])
}

model Representative {
  id                 String   @id @default(cuid())
  nameNp             String?
  nameEn             String?
  position           String
  wardNumber         Int?
  phone              String?
  email              String?
  photoUrl           String?
  status             String   @default("DRAFT")
  sourceMetadataId   String? @unique
  source             SourceMetadata? @relation("RepresentativeSource", fields: [sourceMetadataId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notice {
  id                 String   @id @default(cuid())
  titleNp            String?
  titleEn            String?
  category           String?
  detailUrl          String   @default("/")
  summary            String   @default("")
  imageUrl           String?
  publishedAt        DateTime?
  attachmentUrl      String?
  status             String   @default("DRAFT")
  sourceMetadataId   String? @unique
  source             SourceMetadata? @relation("NoticeSource", fields: [sourceMetadataId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Document {
  id                 String   @id @default(cuid())
  titleNp            String?
  titleEn            String?
  category           String
  fiscalYear         String?
  documentUrl        String
  sourceUrl          String
  publishedAt        DateTime?
  downloadCount      Int      @default(0)
  verificationStatus String   @default("PENDING_REVIEW")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipHash    String?
  userAgent String?
  timestamp DateTime @default(now())
}

model AppealCategory {
  id        String   @id @default(cuid())
  nameNp    String
  nameEn    String
  slug      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appeals   PublicAppeal[]
}

model PublicAppeal {
  id            String       @id @default(cuid())
  referenceId   String       @unique
  type          String
  title         String
  description   String
  wardId        String?
  categoryId    String
  latitude      Float?
  longitude     Float?
  imageUrl      String?
  status        String       @default("PENDING")
  authorId      String?
  authorName    String?
  contact       String?
  isAnonymous   Boolean      @default(true)
  supportCount  Int          @default(0)
  commentCount  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  publishedAt   DateTime?
  resolvedAt    DateTime?
  resolutionNote String?
  resolutionMediaUrl String?
  category      AppealCategory @relation(fields: [categoryId], references: [id])
  votes         AppealVote[]
  comments      AppealComment[]
  reports       AppealReport[]
  responses     AppealResponse[]
  history       AppealStatusHistory[]
  @@index([status, createdAt])
  @@index([categoryId])
  @@index([wardId])
}

model AppealVote {
  id        String       @id @default(cuid())
  appealId  String
  userId    String
  createdAt DateTime     @default(now())
  appeal    PublicAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  @@unique([appealId, userId])
}

model AppealComment {
  id        String        @id @default(cuid())
  appealId  String
  userId    String?
  parentId  String?
  content   String
  status    String         @default("PENDING")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  appeal    PublicAppeal  @relation(fields: [appealId], references: [id], onDelete: Cascade)
  parent    AppealComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   AppealComment[] @relation("CommentReplies")
  reports   AppealReport[]
  @@index([appealId, status])
}

model AppealReport {
  id          String       @id @default(cuid())
  appealId    String
  commentId   String?
  reportedBy  String?
  reason      String
  description String?
  status      String       @default("PENDING")
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?
  appeal      PublicAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  comment     AppealComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model AppealResponse {
  id           String       @id @default(cuid())
  appealId     String
  response     String
  respondedBy  String?
  createdAt    DateTime     @default(now())
  appeal       PublicAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
}

model AppealStatusHistory {
  id        String       @id @default(cuid())
  appealId  String
  status    String
  note      String?
  createdBy String?
  createdAt DateTime     @default(now())
  appeal    PublicAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  @@index([appealId, createdAt])
}
