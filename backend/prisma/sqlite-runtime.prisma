generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/portal-sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

model ImportBatch {
  id                 String   @id @default(cuid())
  sourceType         String
  sourceName         String
  sourceUrl          String
  fetchedAt          DateTime @default(now())
  importedAt         DateTime?
  importingAdminId   String?
  recordsFetched     Int      @default(0)
  newRecords         Int      @default(0)
  updatedRecords     Int      @default(0)
  conflicts          Int      @default(0)
  failedRecords      Int      @default(0)
  status             String   @default("PENDING_REVIEW")
  createdAt          DateTime @default(now())
}

model SourceMetadata {
  id                 String   @id @default(cuid())
  sourceType         String
  sourceName         String
  sourceUrl          String
  sourceRecordId     String?
  sourcePublishedAt  DateTime?
  lastFetchedAt      DateTime?
  lastVerifiedAt     DateTime?
  verificationStatus String   @default("UNVERIFIED")
  importBatchId      String?
  manuallyEdited     Boolean  @default(false)
  manualEditAt       DateTime?
  manuallyEditedBy   String?
  ward               Ward? @relation("WardSource")
  representative     Representative? @relation("RepresentativeSource")
  notice             Notice? @relation("NoticeSource")
}

model Ward {
  id                 String   @id @default(cuid())
  number             Int      @unique
  nameNp             String?
  nameEn             String?
  office             String?
  contact            String?
  status             String   @default("DRAFT")
  sourceMetadataId   String? @unique
  source             SourceMetadata? @relation("WardSource", fields: [sourceMetadataId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MapCategory {
  id        String      @id @default(cuid())
  slug      String      @unique
  nameNp    String
  nameEn    String
  icon      String?
  isActive  Boolean     @default(true)
  isTourism Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  places    MapPlace[]
}

model MapPlace {
  id             String      @id @default(cuid())
  slug           String      @unique
  nameNp         String
  nameEn         String?
  descriptionNp  String?
  descriptionEn  String?
  categoryId     String?
  wardNumber     Int?
  latitude       Float?
  longitude      Float?
  geometryType   String      @default("POINT")
  geometry       String?
  address        String?
  phone          String?
  email          String?
  website        String?
  imageUrl       String?
  openingHours   String?
  isTourism      Boolean     @default(false)
  tourismStatus  String      @default("DRAFT")
  shortDescriptionNp String?
  shortDescriptionEn String?
  historyNp      String?
  historyEn      String?
  culturalSignificanceNp String?
  culturalSignificanceEn String?
  religiousSignificanceNp String?
  religiousSignificanceEn String?
  naturalFeaturesNp String?
  naturalFeaturesEn String?
  activitiesNp   String?
  activitiesEn   String?
  bestTimeNp     String?
  bestTimeEn     String?
  howToReachNp   String?
  howToReachEn   String?
  facilitiesNp   String?
  facilitiesEn   String?
  safetyInfoNp   String?
  safetyInfoEn   String?
  emergencyInfoNp String?
  emergencyInfoEn String?
  viewCount      Int         @default(0)
  averageRating  Float       @default(0)
  ratingCount    Int         @default(0)
  isPublished    Boolean     @default(false)
  isVerified     Boolean     @default(false)
  sourceName     String?
  sourceUrl      String?
  verifiedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  category       MapCategory? @relation(fields: [categoryId], references: [id])
  tourismImages  TourismImage[]
  tourismRatings TourismRating[]
  tourismReviews TourismReview[]
  tourismVisits  TourismVisit[]
  tourismFavorites TourismFavorite[]
  @@index([isPublished, isVerified, wardNumber])
  @@index([categoryId])
}

model TourismImage {
  id        String   @id @default(cuid())
  placeId   String
  url       String
  captionNp String?
  captionEn String?
  altText   String?
  sortOrder Int      @default(0)
  isFeatured Boolean @default(false)
  createdAt DateTime @default(now())
  place     MapPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  @@index([placeId, sortOrder])
}

model TourismRating {
  id          String   @id @default(cuid())
  placeId     String
  visitorHash String
  rating      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  place       MapPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  @@unique([placeId, visitorHash])
  @@index([placeId, rating])
}

model TourismReview {
  id          String   @id @default(cuid())
  placeId     String
  visitorHash String
  content     String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  place       MapPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  reports     TourismReviewReport[]
  @@unique([placeId, visitorHash])
  @@index([placeId, status, createdAt])
}

model TourismReviewReport {
  id          String   @id @default(cuid())
  reviewId    String
  visitorHash String
  reason      String
  details     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  review      TourismReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  @@unique([reviewId, visitorHash])
  @@index([status, createdAt])
}

model TourismVisit {
  id          String   @id @default(cuid())
  placeId     String
  visitorHash String
  dayBucket   String
  createdAt   DateTime @default(now())
  place       MapPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  @@unique([placeId, visitorHash, dayBucket])
  @@index([placeId, dayBucket])
}

model TourismFavorite {
  id          String   @id @default(cuid())
  placeId     String
  visitorHash String
  createdAt   DateTime @default(now())
  place       MapPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  @@unique([placeId, visitorHash])
  @@index([visitorHash])
}

model MapBoundary {
  id          String   @id @default(cuid())
  name        String
  layerType   String   @default("WARD_BOUNDARY")
  wardNumber  Int?
  geoJson     String
  sourceName  String?
  sourceUrl   String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([isPublished, layerType, wardNumber])
}

model Representative {
  id                 String   @id @default(cuid())
  nameNp             String?
  nameEn             String?
  position           String
  wardNumber         Int?
  phone              String?
  email              String?
  photoUrl           String?
  status             String   @default("DRAFT")
  sourceMetadataId   String? @unique
  source             SourceMetadata? @relation("RepresentativeSource", fields: [sourceMetadataId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notice {
  id                 String   @id @default(cuid())
  titleNp            String?
  titleEn            String?
  category           String?
  detailUrl          String   @default("/")
  summary            String   @default("")
  imageUrl           String?
  publishedAt        DateTime?
  attachmentUrl      String?
  status             String   @default("DRAFT")
  sourceMetadataId   String? @unique
  source             SourceMetadata? @relation("NoticeSource", fields: [sourceMetadataId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Document {
  id                 String   @id @default(cuid())
  titleNp            String?
  titleEn            String?
  category           String
  fiscalYear         String?
  documentUrl        String
  sourceUrl          String
  publishedAt        DateTime?
  downloadCount      Int      @default(0)
  verificationStatus String   @default("PENDING_REVIEW")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipHash    String?
  userAgent String?
  timestamp DateTime @default(now())
}

model AppealCategory {
  id        String   @id @default(cuid())
  nameNp    String
  nameEn    String
  slug      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appeals   PublicAppeal[]
}

model PublicAppeal {
  id            String       @id @default(cuid())
  referenceId   String       @unique
  type          String
  title         String
  description   String
  wardId        String?
  categoryId    String
  latitude      Float?
  longitude     Float?
  imageUrl      String?
  status        String       @default("PENDING")
  authorId      String?
  authorName    String?
  contact       String?
  isAnonymous   Boolean      @default(true)
  supportCount  Int          @default(0)
  commentCount  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  publishedAt   DateTime?
  resolvedAt    DateTime?
  resolutionNote String?
  resolutionMediaUrl String?
  category      AppealCategory @relation(fields: [categoryId], references: [id])
  votes         AppealVote[]
  comments      AppealComment[]
  reports       AppealReport[]
  responses     AppealResponse[]
  history       AppealStatusHistory[]
  @@index([status, createdAt])
  @@index([categoryId])
  @@index([wardId])
}

model AppealVote {
  id        String       @id @default(cuid())
  appealId  String
  userId    String
  createdAt DateTime     @default(now())
  appeal    PublicAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  @@unique([appealId, userId])
}

model AppealComment {
  id        String        @id @default(cuid())
  appealId  String
  userId    String?
  parentId  String?
  content   String
  status    String         @default("PENDING")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  appeal    PublicAppeal  @relation(fields: [appealId], references: [id], onDelete: Cascade)
  parent    AppealComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   AppealComment[] @relation("CommentReplies")
  reports   AppealReport[]
  @@index([appealId, status])
}

model AppealReport {
  id          String       @id @default(cuid())
  appealId    String
  commentId   String?
  reportedBy  String?
  reason      String
  description String?
  status      String       @default("PENDING")
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?
  appeal      PublicAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  comment     AppealComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model AppealResponse {
  id           String       @id @default(cuid())
  appealId     String
  response     String
  respondedBy  String?
  createdAt    DateTime     @default(now())
  appeal       PublicAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
}

model AppealStatusHistory {
  id        String       @id @default(cuid())
  appealId  String
  status    String
  note      String?
  createdBy String?
  createdAt DateTime     @default(now())
  appeal    PublicAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  @@index([appealId, createdAt])
}

model OfficialService {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  nameNp                 String
  nameEn                 String
  categoryNp             String?
  categoryEn             String?
  descriptionNp          String?
  descriptionEn          String?
  officialWebsiteUrl     String?
  officialApplicationUrl String?
  officialFormUrl        String?
  officialSourceUrl      String
  sourceName             String
  sourceDocumentName     String?
  verificationStatus     String   @default("NEEDS_REVIEW")
  verifiedAt             DateTime?
  verifiedBy             String?
  notes                  String?
  keywordsJson           String   @default("[]")
  displayOrder           Int      @default(0)
  isPublished            Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([isPublished, verificationStatus, displayOrder])
}

model BudgetSourceDocument {
  id             String   @id @default(cuid())
  sourceUrl      String   @unique
  title          String
  fiscalYear     String
  fileHash       String
  status         String   @default("NEEDS_REVIEW")
  sourceUpdatedAt DateTime?
  checkedAt      DateTime @default(now())
  importedAt     DateTime @default(now())
  totalNpr       Float?
  extractedRows  Int      @default(0)
  validRows      Int      @default(0)
  warningsJson   String   @default("[]")
  lastError      String?
  allocations    BudgetAllocation[]
  @@index([fiscalYear, status, checkedAt])
}

model BudgetAllocation {
  id                String   @id @default(cuid())
  sourceDocumentId  String
  fiscalYear        String
  wardNumber        Int?
  projectName       String
  sector            String
  sectorKey         String
  expenditureHead   String?
  budgetCode        String?
  amountNpr         Float
  rawAmount         String
  rawRow            String
  rowNumber         Int?
  confidence        Float    @default(0)
  sourceDocument    BudgetSourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  @@index([fiscalYear, wardNumber])
  @@index([fiscalYear, sectorKey])
  @@index([sourceDocumentId])
}
