{
  "name": "chaurpati-digital-portal-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run db:generate:sqlite-runtime && npm run db:generate:postgres && tsc -p tsconfig.build.json",
    "build:postgres": "npm run build",
    "db:generate:sqlite-runtime": "prisma generate --schema prisma/sqlite-runtime.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "migrate:sqlite-to-postgres": "node --experimental-sqlite --env-file-if-exists=.env scripts/migrate-sqlite-to-postgres.cjs",
    "start:postgres": "npm run db:migrate:postgres && node --env-file-if-exists=.env dist/main.js",
    "start:dev": "tsc -w -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "prisma": "^6.19.3",
    "typescript": "^5.7.2"
  }
}
