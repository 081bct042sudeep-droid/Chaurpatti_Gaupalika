# Optional map tile URL templates. Each must contain {z}, {x}, and {y}.
# Configure a provider with suitable usage rights before deploying for public traffic.
VITE_MAP_STREET_TILE_URL=
VITE_MAP_SATELLITE_TILE_URL=
VITE_MAP_TERRAIN_TILE_URL=

# Optional API server origin. Production defaults to the deployed Render API.
# Leave blank locally to use the Vite /api development proxy.
VITE_API_ORIGIN=

# Optional starting point from a verified municipal GIS source; leave blank until verified.
VITE_MAP_CENTER_LAT=
VITE_MAP_CENTER_LON=

# Optional Google Maps Embed API key for the Street View map layer.
# Restrict the key to your website's HTTP referrers and the Maps Embed API.
VITE_GOOGLE_MAPS_API_KEY=
